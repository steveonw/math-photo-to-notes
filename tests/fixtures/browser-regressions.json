{
  "schema": "math-photo-notes-regression-fixtures-v1",
  "repair": [
    {
      "name": "preserve unscoped unicode radical",
      "input": "$√x$",
      "expected": "$√x$"
    },
    {
      "name": "restore braced frac command",
      "input": "$frac{a}{b}$",
      "expected": "$\\frac{a}{b}$"
    },
    {
      "name": "restore braced sqrt command",
      "input": "$sqrt{x+1}$",
      "expected": "$\\sqrt{x+1}$"
    },
    {
      "name": "restore theta before subscript",
      "input": "$theta_1$",
      "expected": "$\\theta_1$"
    },
    {
      "name": "restore sin before parenthesis",
      "input": "$sin(x)$",
      "expected": "$\\sin(x)$"
    },
    {
      "name": "normalize unicode minus only in math",
      "input": "words − stay prose; $x−1$",
      "expected": "words − stay prose; $x-1$"
    },
    {
      "name": "convert multiplication symbol in math",
      "input": "$2×x$",
      "expected": "$2\\times x$"
    },
    {
      "name": "preserve ordinary prose command word",
      "input": "The sum of the terms is described in prose.",
      "expected": "The sum of the terms is described in prose."
    }
  ],
  "classification": [
    {
      "name": "explicit no readable text",
      "input": "[No readable text found]",
      "expected": "unclear"
    },
    {
      "name": "math unsure marker",
      "input": "[MATH_UNSURE: seen=\"?\" guess=\"$x$\" note=\"symbol\"] (I think it says: $x$)",
      "expected": "mathunsure"
    },
    {
      "name": "unclear marker",
      "input": "This line has an [unclear] word in otherwise readable notes.",
      "expected": "unclear"
    },
    {
      "name": "short response",
      "input": "Only three words",
      "expected": "review"
    },
    {
      "name": "ordinary complete transcription",
      "input": "This ordinary transcription contains enough readable words to pass the suspicious-success length check.",
      "expected": "good"
    }
  ],
  "validation": [
    {
      "name": "unbalanced inline delimiter",
      "input": "\\(x+1",
      "minWarnings": 1
    },
    {
      "name": "unbalanced display delimiter",
      "input": "\\[x+1",
      "minWarnings": 1
    },
    {
      "name": "malformed fraction",
      "input": "$\\frac{1}$",
      "minWarnings": 1
    },
    {
      "name": "balanced fraction",
      "input": "$\\frac{1}{2}$",
      "minWarnings": 0
    }
  ],
  "assurance": [
    {
      "name": "identical math",
      "primary": "Value: $\\frac{1}{2}$",
      "verifier": "Value: $\\frac{1}{2}$",
      "disagree": false
    },
    {
      "name": "delimiter-only variation",
      "primary": "Value: $\\frac{1}{2}$",
      "verifier": "Value: \\( \\frac{1}{2} \\)",
      "disagree": false
    },
    {
      "name": "sign disagreement",
      "primary": "Result: $x-1$",
      "verifier": "Result: $x+1$",
      "disagree": true
    },
    {
      "name": "exponent disagreement",
      "primary": "Result: $x^2+1$",
      "verifier": "Result: $x^3+1$",
      "disagree": true
    }
  ],
  "pageNumber": [
    {
      "name": "filename page label",
      "item": {
        "name": "lecture-page-012.jpg",
        "metadata": {
          "pageNumber": ""
        },
        "finalText": ""
      },
      "expected": "12"
    },
    {
      "name": "explicit transcription page label",
      "item": {
        "name": "lecture.jpg",
        "metadata": {
          "pageNumber": ""
        },
        "finalText": "Page 27\nThese are lecture notes with enough text."
      },
      "expected": "27"
    }
  ],
  "renderer": [
    {
      "name": "inline fraction",
      "tex": "$\\frac{1}{2}$",
      "expect": "render"
    },
    {
      "name": "sqrt greek subscript",
      "tex": "$\\sqrt{x}+\\theta_1$",
      "expect": "render"
    },
    {
      "name": "sum integral limits",
      "tex": "$\\sum_{n=1}^{10}n^2+\\int_0^1x^2\\,dx$",
      "expect": "render"
    },
    {
      "name": "matrix",
      "tex": "$\\begin{bmatrix}1&2\\\\3&4\\end{bmatrix}$",
      "expect": "render"
    },
    {
      "name": "cases",
      "tex": "$f(x)=\\begin{cases}x^2,&x\\ge 0\\\\-x,&x<0\\end{cases}$",
      "expect": "render"
    },
    {
      "name": "aligned display",
      "tex": "\\[\\begin{aligned}a&=b+c\\\\d&=e-f\\end{aligned}\\]",
      "expect": "render"
    },
    {
      "name": "cancel",
      "tex": "$\\cancel{x}$",
      "expect": "render"
    },
    {
      "name": "cancel to",
      "tex": "$\\cancelto{0}{x}$",
      "expect": "render"
    },
    {
      "name": "overset underbrace",
      "tex": "$\\overset{?}{=}\\quad\\underbrace{x+y}_{\\text{sum}}$",
      "expect": "render"
    },
    {
      "name": "sets arrows text",
      "tex": "$x\\in\\mathbb{R},\\ A\\subseteq B,\\ x\\mapsto x^2,\\ a\\neq b$",
      "expect": "render"
    },
    {
      "name": "malformed exponent",
      "tex": "$x^$",
      "expect": "error"
    },
    {
      "name": "extra closing brace",
      "tex": "$x}$",
      "expect": "error"
    },
    {
      "name": "undefined macro",
      "tex": "$\\foo{x}$",
      "expect": "error"
    },
    {
      "name": "javascript link injection",
      "tex": "$\\href{javascript:alert(1)}{x}$",
      "expect": "error",
      "unsafe": true
    },
    {
      "name": "style injection",
      "tex": "$\\style{position:fixed;inset:0}{x}$",
      "expect": "error",
      "unsafe": true
    },
    {
      "name": "require html bypass",
      "tex": "$\\require{html}\\href{javascript:alert(1)}{x}$",
      "expect": "error",
      "unsafe": true
    }
  ]
}
